   33  date
   34  echo М265852
   35  mkdir -p /root/mephi-linux-security-2026
   36  cp /root/suid-files.out /root/mephi-linux-security-2026/suid-files.out
   37  cp /root/process-monitor.out /root/mephi-linux-security-2026/process-monitor.out
   38  stat /home/user1 > /root/mephi-linux-security-2026/stat.out
