   18  cp /usr/bin/chown /home/user1/chown-cap
   19  chown root:root /home/user1/chown-cap
   20  chmod 755 /home/user1/chown-cap
   21  setcap cap_chown+ep /home/user1/chown-cap
   22  getcap /home/user1/chown-cap
   23  sudo -u user1 touch /home/user1/cap-test
   24  ls -l /home/user1/cap-test
   25  sudo -u user1 /home/user1/chown-cap root:root /home/user1/cap-test
   26  ls -l /home/user1/cap-test
   27  command -v date
   28  visudo -f /etc/sudoers.d/user1-time
   29  chmod 0440 /etc/sudoers.d/user1-time
   30  visudo -c
   31  sudo -l -U user1
